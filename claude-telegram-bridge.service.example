[Unit]
Description=Claude Code Telegram Bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__INSTALL_DIR__
Environment=PATH=__HOME__/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=BRIDGE_WORKDIR=__HOME__
# TELEGRAM_BOT_TOKEN, OWNER_ID, SERVICE_NAME and CLAUDE_BIN live here, mode 600.
EnvironmentFile=__ENV_FILE__
ExecStart=/usr/bin/python3 __INSTALL_DIR__/bridge.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
